    "pdf_page": 52,
    "slide_title": "The minimizer is the marginal velocity"
  },
  "continuity": {
    "html": "<span data-link=\"time\">∂<sub>t</sub>p<sub>t</sub></span> + <span data-link=\"region\">∇·(p<sub>t</sub>v<sub>t</sub>)</span> = 0",
    "file": "lec04-flow-based.pdf",
