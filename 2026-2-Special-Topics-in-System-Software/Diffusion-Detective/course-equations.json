  "fm": {
    "html": "L<sub>FM</sub>(ϕ) = E<sub>t, xₜ∼pₜ</sub> ‖<span data-link=\"prediction\">v<sub>ϕ</sub>(x<sub>t</sub>,t)</span> − v<sub>t</sub>(x<sub>t</sub>)‖²",
    "file": "lec04-flow-based.pdf",
    "pdf_page": 39,
    "slide_title": "Regress the velocity instead"
  },
  "cfm": {
    "html": "L<sub>CFM</sub>(ϕ) = E<sub>t, (x₀,xT)∼π</sub> ‖<span data-link=\"prediction\">v<sub>ϕ</sub>(x<sub>t</sub>,t)</span> − u<sub>t</sub>(x<sub>t</sub>;x<sub>0</sub>,x<sub>T</sub>)‖²",
    "file": "lec04-flow-based.pdf",
    "pdf_page": 50,
    "slide_title": "Certified, and out of reach"
  },
  "loss": {
    "html": "L<sub>CFM</sub>(ϕ) = <span data-link=\"prediction\">L<sub>FM</sub>(ϕ)</span> + <span data-link=\"variance\">C</span>",
